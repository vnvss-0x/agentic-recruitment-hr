# ─────────────────────────────────────────────────────────────────
# Recruitment AI Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# ─────────────────────────────────────────────────────────────────

# ── Google Gemini API ─────────────────────────────────────────────
# Obtenir sur : https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Application ───────────────────────────────────────────────────
APP_NAME="Recruitment AI Backend"
APP_VERSION="0.1.0"
DEBUG=true
API_PREFIX="/v1"

# ── Upload ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── LangGraph ─────────────────────────────────────────────────────
LANGGRAPH_RECURSION_LIMIT=50

# ── RAG (ChromaDB) ────────────────────────────────────────────────
# Embeddings : sentence-transformers/all-MiniLM-L6-v2 (local, pas de clé API)
# Index : data/chroma_db/ — seed : python scripts/seed_knowledge_base.py
