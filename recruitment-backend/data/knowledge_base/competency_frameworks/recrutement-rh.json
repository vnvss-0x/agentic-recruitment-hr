  },
  "hitl_checkpoints": {
    "hr_shortlist": {
      "purpose": "Valider la pertinence des candidats avant entretiens",
      "allowed_actions": ["approve", "modify", "request_reanalysis"]
    },
    "manager_final": {
      "purpose": "Décision finale humaine sur le recrutement",
      "allowed_actions": ["hire", "additional_interview", "cancel"]
    }
  },
  "rag_usage": {
    "job_analysis": "Comparer aux job_templates historiques",
    "cv_screening": "Aligner sur grilles et référentiels de compétences",
    "interviews": "Suggérer questions calibrées par niveau"
  }
