{
  "domain": "recruitment_hr",
  "version": "1.0",
  "process_stages": [
    "Analyse de poste et profil cible",
    "Sourcing et présélection CV",
    "Entretiens techniques et comportementaux",
    "Décision collégiale RH + manager",
    "Offre et onboarding"
  ],
  "kpis": {
    "time_to_hire_days": { "target": 45, "critical": 70 },
